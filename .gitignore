# --- build output -----------------------------------------------------------
/target
**/*.rs.bk
*.pdb
# web demo build output (scripts/build_web.sh)
/apps/web/www/pkg/
/_site/
/dist/

# --- application data written at run time ----------------------------------
/user-data/
/exports/
/screenshots/
# optional third-party downloads fetched by scripts/fetch_assets.sh
/assets/external/
# demo recordings (scripts/record_demo.sh keeps only the final GIF)
/recordings/

# --- secrets and local configuration -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.local.md

# --- private notes, promotion drafts and AI-agent files (kept locally) -------
LAUNCH*.md
LAUNCH_KIT.md
LAUNCH_POSTS*.md
/launch/
/docs/launch/
/.claude/
CLAUDE.md
CLAUDE.local.md
/.cursor/
/.aider*
/.codex/

# --- editors and operating systems ---------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# generated by cargo-about for release archives
/THIRD_PARTY_LICENSES.html
