// Simplified artificial chemistry: A + B ⇌ C with a catalyst.
(
    id: "artificial-chemistry",
    name: "Artificial chemistry",
    description: "Molecules A and B diffuse (random walks) and react when they collide: A + B -> C. C slowly decomposes back into A + B. Next to a catalyst K (which is never consumed) both directions run 90 times faster, so the catalyst speeds up the approach to equilibrium without shifting it (microscopic reversibility). Atoms are conserved exactly: every C holds one A and one B, so #A + #C and #B + #C never change. The system relaxes to a dynamic equilibrium in which formation and decomposition balance (law of mass action).",
    seed: 5,
    expected: "C accumulates quickly (much faster with the catalyst than without) and settles at a dynamic equilibrium; #A + #C and #B + #C stay exactly 300.",
    tags: ["chemistry", "conservation", "catalysis"],
    system: (
        name: "Artificial chemistry",
        description: "A + B ⇌ C with catalyst K; atom counts conserved.",
        entity_types: [
            (
                name: "a",
                description: "Molecule A.",
                color: (0.95, 0.35, 0.30, 1.0),
                icon: "A",
                size: 0.6,
                movement: RandomWalk(speed: 0.6),
                energy: (initial: 1.0, max: 1.0, metabolism: 0.0, starvation: false),
                perception: 3.0,
                initial: (count: 300, distribution: Uniform),
            ),
            (
                name: "b",
                description: "Molecule B.",
                color: (0.30, 0.55, 0.95, 1.0),
                icon: "B",
                size: 0.6,
                movement: RandomWalk(speed: 0.6),
                energy: (initial: 1.0, max: 1.0, metabolism: 0.0, starvation: false),
                perception: 3.0,
                initial: (count: 300, distribution: Uniform),
            ),
            (
                name: "c",
                description: "Compound AB.",
                color: (0.65, 0.35, 0.85, 1.0),
                icon: "C",
                size: 0.8,
                movement: RandomWalk(speed: 0.4),
                energy: (initial: 1.0, max: 1.0, metabolism: 0.0, starvation: false),
                perception: 3.0,
            ),
            (
                name: "k",
                description: "Catalyst (never consumed).",
                color: (0.95, 0.85, 0.25, 1.0),
                icon: "K",
                size: 1.0,
                movement: RandomWalk(speed: 0.2),
                energy: (initial: 1.0, max: 1.0, metabolism: 0.0, starvation: false),
                perception: 3.0,
                initial: (count: 20, distribution: Uniform),
            ),
        ],
        rules: [
            "rule catalysed_binding for a: on_collision with b when nearby(k, radius=2.5) > 0 then eat(other, efficiency=0), transform_into(c) probability 0.9",
            "rule binding for a: on_collision with b when nearby(k, radius=2.5) == 0 then eat(other, efficiency=0), transform_into(c) probability 0.01",
            "rule catalysed_decomposition for c: when nearby(k, radius=2.5) > 0 then transform_into(a), spawn(b, 1) probability 0.27",
            "rule decomposition for c: when nearby(k, radius=2.5) == 0 then transform_into(a), spawn(b, 1) probability 0.003",
        ],
        world: (
            width: 48,
            height: 48,
            topology: torus,
        ),
    ),
)
