// Virus & cells: infection, latency and lysis.
(
    id: "virus-and-cells",
    name: "Virus & cells",
    description: "Host cells grow on a nutrient field. Free virions drift and decay; a virion touching a cell is adsorbed and infects it with probability 0.5. An infected cell stops dividing and, after a latent period of 12 ticks, lyses and releases a burst of 6 new virions. Virions also arrive occasionally from outside (virus influx). The result is a lytic cycle: epidemics that crash the host population, virus decay once hosts are scarce, host recovery, and the next epidemic.",
    seed: 7,
    expected: "Host–virus cycles: cells grow, an epidemic follows, cells crash below half of their peak while the virus peaks after them; the virus then declines and cells recover, again and again.",
    tags: ["epidemiology", "host-parasite", "oscillation"],
    system: (
        name: "Virus & cells",
        description: "Lytic virus infecting cells that grow on nutrient.",
        entity_types: [
            (
                name: "cell",
                description: "Host cell: feeds on nutrient and divides.",
                color: (0.30, 0.60, 0.95, 1.0),
                icon: "🔵",
                sprite: "cell",
                size: 0.8,
                movement: RandomWalk(speed: 0.5),
                energy: (initial: 6.0, max: 20.0, metabolism: 0.08, starvation: true),
                reproduction: (mode: Asexual, cost: 6.0, cooldown: 6, litter: 1),
                perception: 2.0,
                initial: (count: 150, distribution: Uniform),
            ),
            (
                name: "infected",
                description: "Infected cell: makes virions and lyses after the latent period.",
                color: (0.95, 0.30, 0.25, 1.0),
                icon: "🔴",
                sprite: "cell",
                size: 0.8,
                movement: RandomWalk(speed: 0.1),
                energy: (initial: 6.0, max: 20.0, metabolism: 0.08, starvation: true),
                perception: 2.0,
            ),
            (
                name: "virus",
                description: "Free virion: drifts, is adsorbed by the first cell it touches, decays after 30 ticks.",
                color: (0.75, 0.25, 0.85, 1.0),
                icon: "🦠",
                sprite: "virion",
                size: 0.3,
                movement: RandomWalk(speed: 0.8),
                energy: (initial: 1.0, max: 1.0, metabolism: 0.0, starvation: false),
                lifecycle: (max_age: Some(30)),
                perception: 2.0,
                initial: (count: 20, distribution: Uniform),
            ),
        ],
        relationships: [
            (subject: "cell", kind: Transforms(trigger: Contact("virus"), probability: 0.5), object: "infected"),
        ],
        rules: [
            "rule feed for cell: when field(nutrient) > 0 and energy < 18 then consume(nutrient, 0.5) priority 500",
            "rule divide for cell: when energy >= 12 then reproduce() priority 300",
            "rule feed for infected: when field(nutrient) > 0 and energy < 18 then consume(nutrient, 0.5) priority 500",
            "rule adsorb for virus: on_collision with cell then die() priority 1000",
            "rule lyse for infected: when state_age >= 12 then die() priority 1000",
            "rule burst for infected: on_death then spawn(virus, 6)",
        ],
        world: (
            width: 48,
            height: 48,
            topology: torus,
            random_events: [
                (name: "virus influx", probability: 0.004, effect: Immigration(entity: "virus", count: 10)),
            ],
            resources: [
                (
                    name: "nutrient",
                    color: (0.90, 0.75, 0.30, 1.0),
                    initial: Uniform(1.0),
                    regen: 0.01,
                    max: 1.0,
                    diffusion: 0.05,
                ),
            ],
        ),
        end_conditions: [AllExtinct],
    ),
)
