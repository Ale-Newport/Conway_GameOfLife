// Bacterial growth: logistic growth emerging from a regrowing nutrient field.
(
    id: "bacterial-growth",
    name: "Bacterial growth",
    description: "Bacteria take up nutrient from a slowly regrowing, diffusing field and divide in two when they have stored enough energy. While nutrient is plentiful the colony grows exponentially; as uptake approaches the nutrient supply the per-capita growth rate falls and the population levels off: logistic growth that is not programmed but emerges from resource limitation.",
    seed: 42,
    expected: "S-shaped growth from 20 cells to a plateau near the carrying capacity K = supply / maintenance = (0.01 per cell × 2304 cells) / 0.08 ≈ 290 bacteria.",
    tags: ["ecology", "growth", "logistic"],
    system: (
        name: "Bacterial growth",
        description: "Bacteria feeding on a nutrient field (logistic growth from resource limitation).",
        entity_types: [
            (
                name: "bacterium",
                description: "Feeds on nutrient; divides when its energy reaches 12 (each daughter keeps half).",
                color: (0.35, 0.80, 0.45, 1.0),
                icon: "🦠",
                sprite: "bacterium",
                size: 0.6,
                movement: RandomWalk(speed: 0.6),
                energy: (initial: 6.0, max: 20.0, metabolism: 0.08, starvation: true),
                reproduction: (mode: Asexual, cost: 6.0, cooldown: 5, litter: 1),
                perception: 2.0,
                initial: (count: 20, distribution: Cluster(x: 24.0, y: 24.0, radius: 12.0)),
            ),
        ],
        rules: [
            "rule feed for bacterium: when field(nutrient) > 0 and energy < 18 then consume(nutrient, 0.5) priority 500",
            "rule divide for bacterium: when energy >= 12 then reproduce() priority 300",
        ],
        world: (
            width: 48,
            height: 48,
            topology: torus,
            resources: [
                (
                    name: "nutrient",
                    color: (0.90, 0.75, 0.30, 1.0),
                    initial: Uniform(0.5),
                    regen: 0.01,
                    max: 1.0,
                    diffusion: 0.05,
                    energy_value: 1.0,
                ),
            ],
        ),
        end_conditions: [Extinction("bacterium")],
    ),
)
