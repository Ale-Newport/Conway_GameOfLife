// Alien ecosystem: invented organisms in a three-level food chain on a tidally locked moon.
(
    id: "alien-ecosystem",
    name: "Alien ecosystem",
    description: "On a tidally locked moon, lumen moss photosynthesises from starlight, growing fastest on the bright day side (an environment gradient that slowly pulses with the planet's orbit). Drifting medusae graze the moss and flee from spikemaws, which hunt them. Meteor showers scatter extra starlight dust, void storms wipe out patches of life, and spores and drifters arrive from beyond the horizon. All behaviour comes from the relationship graph (consumes, avoids), the types' reproduction settings and two short rules.",
    seed: 2024,
    expected: "Moss carpets the bright side, medusae follow it and spikemaws follow the medusae; all three levels persist with fluctuating numbers. With few predators the dynamics are noisy: on some seeds (including the default one) the spikemaws overshoot and the medusae survive for a while only as a few drifting newcomers before recovering. Removing the spikemaws always makes the medusae more numerous and the moss much sparser (top-down control, a trophic cascade).",
    tags: ["ecology", "food chain", "invented"],
    system: (
        name: "Alien ecosystem",
        description: "Lumen moss -> medusae -> spikemaws under a day-side light gradient.",
        entity_types: [
            (
                name: "lumen_moss",
                description: "Sessile glowing moss living on starlight.",
                color: (0.30, 0.95, 0.75, 1.0),
                icon: "✨",
                sprite: "moss",
                size: 0.8,
                energy: (initial: 5.0, max: 15.0, metabolism: 0.04, starvation: true),
                reproduction: (mode: Asexual, cost: 5.0, cooldown: 10, litter: 1),
                lifecycle: (max_age: Some(600), maturity: 10),
                perception: 2.0,
                initial: (count: 600, distribution: Uniform),
            ),
            (
                name: "medusa",
                description: "Drifting grazer that eats moss and flees spikemaws.",
                color: (0.55, 0.65, 1.00, 1.0),
                icon: "🎐",
                sprite: "medusa",
                size: 1.0,
                movement: Directed(speed: 0.6, turn: 0.7),
                energy: (initial: 25.0, max: 40.0, metabolism: 0.06, starvation: true),
                reproduction: (mode: Asexual, cost: 10.0, cooldown: 20, litter: 1, rate: 0.05),
                lifecycle: (max_age: Some(700), maturity: 20),
                perception: 6.0,
                initial: (count: 60, distribution: Uniform),
            ),
            (
                name: "spikemaw",
                description: "Predator hunting medusae.",
                color: (0.95, 0.30, 0.40, 1.0),
                icon: "🦂",
                sprite: "spikemaw",
                size: 1.2,
                movement: Directed(speed: 0.75, turn: 0.5),
                energy: (initial: 40.0, max: 60.0, metabolism: 0.06, starvation: true),
                reproduction: (mode: Asexual, cost: 15.0, cooldown: 40, litter: 1, rate: 0.1),
                lifecycle: (max_age: Some(900), maturity: 40),
                perception: 8.0,
                initial: (count: 10, distribution: Uniform),
            ),
        ],
        relationships: [
            (subject: "medusa", kind: Consumes(efficiency: 0.3, hunger: Some(25.0), radius: 6.0, handling: 25), object: "lumen_moss"),
            (subject: "spikemaw", kind: Consumes(efficiency: 0.5, hunger: Some(45.0), radius: 8.0, handling: 30), object: "medusa"),
            (subject: "medusa", kind: Avoids(radius: 3.0, speed_factor: 1.2), object: "spikemaw"),
        ],
        rules: [
            "rule photosynthesis for lumen_moss: when energy < 14 and field(starlight) > 0 then consume(starlight, 0.4 * field(daylight)) priority 500",
            "rule spread for lumen_moss: when age >= 10 and energy >= 10 and nearby(lumen_moss, radius=1.5) < 4 then reproduce(probability=0.1) priority 300",
        ],
        world: (
            width: 48,
            height: 48,
            topology: torus,
            resources: [
                (
                    name: "starlight",
                    color: (0.95, 0.90, 0.55, 1.0),
                    initial: Uniform(1.0),
                    regen: 0.06,
                    max: 1.0,
                    diffusion: 0.2,
                ),
            ],
            environment: [
                (name: "daylight", pattern: Gradient(from: 0.3, to: 1.0, axis: X), seasonal: Some((amplitude: 0.2, period: 500.0))),
            ],
            random_events: [
                (name: "meteor shower", probability: 0.01, effect: ResourcePulse(resource: "starlight", amount: 2.0, radius: 6.0)),
                (name: "void storm", probability: 0.002, effect: Catastrophe(radius: 5.0, kill_probability: 0.5)),
                (name: "spore drift", probability: 0.1, effect: Immigration(entity: "lumen_moss", count: 3)),
                (name: "medusa drift", probability: 0.02, effect: Immigration(entity: "medusa", count: 2)),
                (name: "spikemaw arrival", probability: 0.005, effect: Immigration(entity: "spikemaw", count: 1)),
            ],
        ),
        end_conditions: [AllExtinct],
    ),
)
