// Producers & consumers: energy flow through three trophic levels.
(
    id: "producers-consumers",
    name: "Producers & consumers",
    description: "Energy enters the food web through plants, which convert sunlight (a regrowing, diffusing resource) into energy and spread where they are not crowded. Grazers eat plants and hunters eat grazers. Each meal keeps only part of the prey's energy (30 % for grazers, 50 % for hunters; the rest is lost as heat), every organism pays maintenance every tick, and meals take handling time. The standing energy of each level therefore shrinks up the chain: an energy pyramid (Lindeman 1942). Small seed rain and migration events model the surrounding landscape and rescue levels that crash locally.",
    seed: 99,
    expected: "Plants hold several times more energy than grazers, and grazers more than hunters (a pyramid of standing energy and of numbers); grazer and hunter numbers cycle.",
    tags: ["ecology", "energy flow", "trophic levels"],
    system: (
        name: "Producers & consumers",
        description: "Sunlight → plants → grazers → hunters.",
        entity_types: [
            (
                name: "plant",
                description: "Producer: converts sunlight into energy; seeds only where fewer than 4 plants grow nearby.",
                color: (0.25, 0.75, 0.30, 1.0),
                icon: "🌿",
                sprite: "plant",
                size: 0.8,
                energy: (initial: 5.0, max: 15.0, metabolism: 0.04, starvation: true),
                reproduction: (mode: Asexual, cost: 5.0, cooldown: 10, litter: 1),
                lifecycle: (max_age: Some(600), maturity: 10),
                perception: 2.0,
                initial: (count: 600, distribution: Uniform),
            ),
            (
                name: "grazer",
                description: "Primary consumer: eats plants (30 % assimilation, one plant per 25 ticks at most).",
                color: (0.85, 0.75, 0.40, 1.0),
                icon: "🐑",
                sprite: "grazer",
                size: 1.0,
                movement: Directed(speed: 0.6, turn: 0.7),
                energy: (initial: 25.0, max: 40.0, metabolism: 0.06, starvation: true),
                reproduction: (mode: Asexual, cost: 10.0, cooldown: 20, litter: 1, rate: 0.05),
                lifecycle: (max_age: Some(700), maturity: 20),
                perception: 6.0,
                initial: (count: 60, distribution: Uniform),
            ),
            (
                name: "hunter",
                description: "Secondary consumer: eats grazers (50 % assimilation, one grazer per 30 ticks at most).",
                color: (0.80, 0.25, 0.20, 1.0),
                icon: "🐺",
                sprite: "hunter",
                size: 1.2,
                movement: Directed(speed: 0.75, turn: 0.5),
                energy: (initial: 40.0, max: 60.0, metabolism: 0.06, starvation: true),
                reproduction: (mode: Asexual, cost: 15.0, cooldown: 40, litter: 1, rate: 0.1),
                lifecycle: (max_age: Some(900), maturity: 40),
                perception: 8.0,
                initial: (count: 10, distribution: Uniform),
            ),
        ],
        relationships: [
            (subject: "plant", kind: Consumes(hunger: Some(14.0), bite: 0.3), object: "sunlight"),
            (subject: "grazer", kind: Consumes(efficiency: 0.3, hunger: Some(25.0), radius: 6.0, handling: 25), object: "plant"),
            (subject: "hunter", kind: Consumes(efficiency: 0.5, hunger: Some(45.0), radius: 8.0, handling: 30), object: "grazer"),
            (subject: "grazer", kind: Avoids(radius: 3.0, speed_factor: 1.2), object: "hunter"),
        ],
        rules: [
            "rule spread for plant: when age >= 10 and energy >= 10 and nearby(plant, radius=1.5) < 4 then reproduce(probability=0.1) priority 300",
        ],
        world: (
            width: 48,
            height: 48,
            topology: torus,
            random_events: [
                (name: "seed rain", probability: 0.1, effect: Immigration(entity: "plant", count: 3)),
                (name: "grazer migration", probability: 0.02, effect: Immigration(entity: "grazer", count: 2)),
                (name: "hunter migration", probability: 0.005, effect: Immigration(entity: "hunter", count: 1)),
            ],
            resources: [
                (
                    name: "sunlight",
                    color: (0.95, 0.90, 0.40, 1.0),
                    initial: Uniform(1.0),
                    regen: 0.06,
                    max: 1.0,
                    diffusion: 0.2,
                ),
            ],
        ),
        end_conditions: [AllExtinct],
    ),
)
