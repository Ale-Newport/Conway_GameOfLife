// Temperate forest with several trophic levels: producers (oak, birch, pine, spruce and the
// herb, shrub and moss layers), primary consumers (deer, wapiti, boar, rabbits, rats, beetles,
// worms, butterflies, bees), secondary consumers (foxes, songbirds, bats, frogs, lizards, snakes,
// spiders, wasps, ants), apex predators (wolves in packs, a bear, golden eagles), scavengers and
// decomposers. Rabbit haemorrhagic disease reaches the rabbits on day 20.
(
    id: "temperate_forest",
    name: "Temperate forest",
    description: "A 2.6 km² temperate forest with clearings (80 × 80 cells of 20 m) and five trophic levels. Wolf packs follow their leader on hunts, foxes and songbirds defend territories, rabbits and deer give alarm calls, bats and the bear hibernate in winter, ants lay pheromone trails and bees pollinate. Rabbit haemorrhagic disease arrives on day 20 (infected.rhd). Watch biomass_* per trophic level, population.*, fights, alarms and hibernating.",
    seed: 11,
    config: (
        world: (
            width: 80,
            height: 80,
            cell_size_m: 20.0,
            sea_level: 0.0,
            relief: 0.03,
            roughness: 0.45,
            continentality: 0.6,
            river_count: 1,
            lake_tendency: 0.5,
            base_temperature_c: 10.0,
            latitude_gradient: 2.0,
            rainfall_mm: 850.0,
            seasonality: 10.0,
        ),
        terrain: generated,
        rules: ecological,
        vegetation: (initial_fraction: 0.6, seed_bank: 1.0),
        trees: (density_per_ha: 70.0, species: ["oak", "birch", "pine", "spruce"]),
        soil: (litter_kg_m2: 0.2, deadwood_kg_m2: 0.1, mycelium_kg_m2: 0.015, mycorrhiza_kg_m2: 0.003),
        animals: [
            (species: "deer", count: 30),
            (species: "stag", count: 15),
            (species: "boar", count: 16),
            (species: "rabbit", count: 80),
            (species: "rat", count: 30),
            (species: "fox", count: 6),
            (species: "wolf", count: 7, groups: Some(1)),
            (species: "bear", count: 1),
            (species: "eagle", count: 2),
            (species: "raven", count: 4),
            (species: "songbird", count: 40),
            (species: "bat", count: 30),
            (species: "frog", count: 30),
            (species: "lizard", count: 20),
            (species: "snake", count: 8),
            (species: "beetle", count: 40000000),
            (species: "worm", count: 60000000),
            (species: "butterfly", count: 1000000),
            (species: "spider", count: 8000000),
            (species: "wasp", count: 200000),
            (species: "ant", count: 6),
            (species: "bee", count: 2),
        ],
        pathogens: [
            (
                id: "rhd",
                name: "Rabbit haemorrhagic disease",
                hosts: ["rabbit"],
                transmission_per_hour: 0.02,
                contact_m: 30.0,
                infectious_days: 2.0,
                mortality_per_day: 0.4,
                immunity_days: 0.0,
                virulence: 0.6,
            ),
        ],
        events: [
            (day: 20.0, action: outbreak(pathogen: "rhd", species: "rabbit", count: 4)),
        ],
        params: {"mutation_rate": 0.1},
    ),
)
