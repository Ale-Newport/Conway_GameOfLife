    model: LifeLike(
        preset: anneal,
        topology: torus,
        width: 256,
        height: 256,
        init: [Random(density: 0.5)],
    ),
    reference: "Vichniac (1984); CelLab 'Vote' (docs/research/automata-catalog.md §2.11)",
)
