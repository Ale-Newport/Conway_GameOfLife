# Emergence Lab needs no secrets, API keys or network services.
# These optional variables change where the desktop app looks for files.
# Copy to `.env` (git-ignored) or export them in your shell.

# Asset folder (default: <executable dir>/assets, then the workspace assets/)
# EMERGENCE_LAB_ASSETS=/path/to/Conway_GameOfLife/assets

# Folder for saves, exports and screenshots (default: the platform's user data folder)
# EMERGENCE_LAB_DATA=/path/to/emergence-lab-data

# Log level for the desktop app and CLI (Bevy / tracing filter syntax)
# RUST_LOG=info
