<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Emergence Lab: third-party licences</title>
<style>
body { font: 15px/1.5 system-ui, sans-serif; max-width: 960px; margin: 2em auto; padding: 0 16px; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 12px; border-radius: 6px; }
li { margin: 2px 0; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>The Emergence Lab binaries include the following Rust crates. Data files under
<code>assets/</code> are listed separately in <code>ASSET_LICENSES.md</code>.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licence texts</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
