// Grey heron (Ardea cinerea): wading ambush predator of fish and frogs, nests in heronries.
// Mass 1–2 kg, longevity ≈ 15 yr wild, maturity ≈ 2 yr, 3–5 eggs incubated ≈ 26 d (AnAge,
// order of magnitude). Reaches individual fish swimming at most 0.5 m deep, and gleans the
// stickleback field where the water is at most 1 m deep (the shallows). Procedural `heron` rig.
(
    id: "heron",
    name: "Grey heron",
    scientific_name: "Ardea cinerea",
    class: bird,
    roles: [carnivore, predator, social],
    diet: [
        (food: prey("small_fish"), preference: 1.0),
        (food: prey("frog"), preference: 0.8),
        (food: prey("perch"), preference: 0.7),
        (food: prey("rat"), preference: 0.3),
        (food: prey("bream"), preference: 0.2),
        (food: prey("snake"), preference: 0.2),
    ],
    locomotion: [walk, fly],
    habitat: (
        biomes: [wetland, lake, river, grassland],
        max_slope: 100.0,
        max_wade_depth_m: 0.5,
        refuges: [trees],
    ),
    body: (mass_kg: 1.5, length_m: 0.95, thermoregulation: endotherm, body_temperature_c: 40.5),
    metabolism: (field_multiplier: 2.2, fasting_days: Some(5.0), dehydration_days: 2.0, intake_per_hour: 1.0),
    movement: (sprint_speed_m_s: Some(14.0), cruise_fraction: 0.4, endurance_s: 3600.0, agility: 2.0, flight_altitude_m: 40.0),
    perception: (vision_m: 300.0, fov_deg: 300.0, hearing_m: 100.0),
    life: (lifespan_years: 15.0, maturity_days: 730.0),
    reproduction: (
        mode: sexual,
        development: eggs(laying_days: 8.0, incubation_days: 26.0),
        litter: (3, 5),
        breeding_seasons: [spring],
        interval_days: 330.0,
        parental_care_days: 50.0,
        birth_mass_fraction: Some(0.04),
        min_energy_fraction: 0.5,
    ),
    social: (structure: colony, group_size: (2, 12), cohesion: 0.1, alignment: None, territorial: false, territory_radius_m: 0.0, alarm_calls: false),
    behaviour: (
        activity: diurnal,
        weights: (forage: 1.0, hunt: 1.3, scavenge: 0.0, flee: 2.0, drink: 1.0, rest: 0.6, sleep: 1.0, mate: 1.0, wander: 0.2, defend: 0.0, migrate: 0.0),
        boldness: 0.5,
        vigilance: 0.7,
        hunting: ambush,
    ),
    combat: (attack: 0.6, defence: 0.3, aggression: 0.3),
    climate: (preferred_c: (0.0, 28.0), tolerance_c: (-20.0, 40.0)),
    seasonal: (migrates: false, migration_range_m: 2000.0, hibernation: None),
    representation: individual,
