// Golden eagle (Aquila chrysaetos): soaring predator of hares, rodents, birds and reptiles;
// scavenges in winter. Mass 4.3–4.8 kg, longevity 48 yr record (≈ 25 yr wild), maturity 4 yr,
// 2 eggs incubated 40 d: docs/research/ecology-alife.md §10.3; flight 129 km/h (Hirt et al. 2017).
// Vision capped at 1.5 km for query cost. Model: manifest `hawk` (eagle proxy); rig `eagle`.
(
    id: "eagle",
    name: "Golden eagle",
    scientific_name: "Aquila chrysaetos",
    class: bird,
    roles: [carnivore, predator, apex, scavenger],
    diet: [
        (food: prey("rabbit"), preference: 1.0),
        (food: prey("rat"), preference: 0.6),
        (food: carrion, preference: 0.6),
        (food: prey("duck"), preference: 0.5),
        (food: prey("snake"), preference: 0.4),
        (food: prey("lizard"), preference: 0.3),
    ],
    locomotion: [walk, fly],
    habitat: (
        biomes: [mountain, tundra, grassland, temperate_forest, savanna, desert],
        max_slope: 100.0,
        max_wade_depth_m: 0.05,
        refuges: [trees],
    ),
    body: (mass_kg: 4.5, length_m: 0.85, thermoregulation: endotherm, body_temperature_c: 40.0),
    metabolism: (field_multiplier: 2.5, fasting_days: Some(8.0), dehydration_days: 2.0, intake_per_hour: 1.5),
    movement: (sprint_speed_m_s: Some(36.0), cruise_fraction: 0.3, endurance_s: 3600.0, agility: 2.5, flight_altitude_m: 120.0),
    perception: (vision_m: 1500.0, fov_deg: 300.0, hearing_m: 200.0),
    life: (lifespan_years: 25.0, maturity_days: 1460.0),
    reproduction: (
        mode: sexual,
        development: eggs(laying_days: 5.0, incubation_days: 43.0),
        litter: (1, 2),
        breeding_seasons: [spring],
        interval_days: 330.0,
        parental_care_days: 80.0,
        birth_mass_fraction: Some(0.025),
        min_energy_fraction: 0.5,
    ),
    social: (structure: pair, group_size: (1, 2), cohesion: 0.3, alignment: None, territorial: true, territory_radius_m: 3000.0, alarm_calls: false),
    behaviour: (
        activity: diurnal,
        weights: (forage: 0.0, hunt: 1.3, scavenge: 0.8, flee: 1.0, drink: 1.0, rest: 0.5, sleep: 1.0, mate: 1.0, wander: 0.3, defend: 0.8, migrate: 0.0),
        boldness: 0.8,
        vigilance: 0.7,
        hunting: stalk,
    ),
    combat: (attack: 1.2, defence: 0.6, aggression: 0.6),
    climate: (preferred_c: (-10.0, 25.0), tolerance_c: (-40.0, 40.0)),
    seasonal: (migrates: false, migration_range_m: 2000.0, hibernation: None),
    representation: individual,
    visual: (model: Some("hawk"), procedural: Some("eagle"), body_plan: bird, color: (0.35, 0.25, 0.15), scale: 1.0),
)
