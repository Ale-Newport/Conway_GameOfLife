// Red fox (Vulpes vulpes): omnivorous stalking predator of small mammals and scavenger.
// Mass 4.1–4.8 kg, longevity 21 yr record, maturity ~0.85 yr, litter 4.6–5, gestation 52 d:
// docs/research/ecology-alife.md §10.3. Sprint 48 km/h (Hirt et al. 2017 dataset).
(
    id: "fox",
    name: "Red fox",
    scientific_name: "Vulpes vulpes",
    class: mammal,
    roles: [omnivore, predator, scavenger, solitary],
    diet: [
        (food: prey("rabbit"), preference: 1.0),
        (food: prey("rat"), preference: 0.8),
        (food: carrion, preference: 0.7),
        (food: prey("duck"), preference: 0.4),
        (food: eggs, preference: 0.5),
        (food: prey("beetle"), preference: 0.4),
        (food: prey("worm"), preference: 0.2),
        (food: prey("frog"), preference: 0.2),
        (food: plant(shrubs), preference: 0.15),
        (food: fungi, preference: 0.1),
    ],
    locomotion: [walk, run, jump, swim, burrow],
    habitat: (
        biomes: [grassland, temperate_forest, tundra, wetland, beach, savanna, mountain],
        max_slope: 1.2,
        max_wade_depth_m: 0.3,
        refuges: [burrow, dense_vegetation],
    ),
    body: (mass_kg: 5.0, length_m: 0.7, thermoregulation: endotherm, body_temperature_c: 38.5),
    metabolism: (field_multiplier: 2.2, fasting_days: Some(6.0), dehydration_days: 3.0, intake_per_hour: 1.0),
    movement: (sprint_speed_m_s: Some(13.3), cruise_fraction: 0.3, endurance_s: 90.0, agility: 3.0),
    perception: (vision_m: 220.0, fov_deg: 260.0, hearing_m: 300.0),
    life: (lifespan_years: 12.0, maturity_days: 300.0),
    reproduction: (
        mode: sexual,
        development: live(gestation_days: 52.0),
        litter: (3, 6),
        breeding_seasons: [winter],
        interval_days: 330.0,
        parental_care_days: 90.0,
        birth_mass_fraction: Some(0.025),
        min_energy_fraction: 0.5,
    ),
    social: (structure: solitary, group_size: (1, 2), cohesion: 0.0, territorial: true, territory_radius_m: 500.0),
    behaviour: (
        activity: nocturnal,
        weights: (forage: 0.6, hunt: 1.2, scavenge: 1.0, flee: 2.5, drink: 1.2, rest: 0.5, sleep: 1.0, mate: 1.0, wander: 0.2),
        boldness: 0.5,
        vigilance: 0.6,
        hunting: stalk,
    ),
    combat: (attack: 0.6, defence: 0.4, aggression: 0.4),
    climate: (preferred_c: (-5.0, 20.0), tolerance_c: (-40.0, 40.0)),
    visual: (model: Some("fox"), procedural: Some("fox"), body_plan: quadruped, color: (0.8, 0.4, 0.15), scale: 1.0),
)
