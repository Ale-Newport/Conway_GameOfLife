    id: "perch",
    name: "European perch",
    scientific_name: "Perca fluviatilis",
    class: fish,
    roles: [carnivore, predator, prey, social],
    diet: [
        (food: prey("small_fish"), preference: 1.0),
        (food: prey("frog"), preference: 0.3),
