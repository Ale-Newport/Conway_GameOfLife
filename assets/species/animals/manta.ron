// Reef manta ray (Mobula alfredi): filter feeder of plankton (the algae layer stands for it).
// Mass ≈ 700 kg, ≈ 40 yr, maturity ≈ 10 yr, one pup after ≈ 1 yr every 2+ years (order of
// magnitude). Its `herbivore` role only places it among primary consumers. `vision_m` 100 m
// stands for finding plankton-rich water while cruising (designer value).
// Fish feel the air temperature of their cell (at least 4 °C in water) as a proxy for water
// temperature. `litter` counts recruits that survive the larval stage, not eggs.
// Model: manifest `manta_ray`.
(
    id: "manta",
    name: "Reef manta ray",
    scientific_name: "Mobula alfredi",
    class: fish,
    roles: [herbivore, prey, solitary],
    diet: [
        (food: plant(algae), preference: 1.0),
    ],
    locomotion: [swim],
    habitat: (
        biomes: [ocean, reef],
        aquatic: true,
        water: salt,
        min_depth_m: 3.0,
        max_slope: 100.0,
        max_wade_depth_m: 0.0,
        refuges: [],
    ),
    body: (mass_kg: 700.0, length_m: 4.0, thermoregulation: ectotherm, body_temperature_c: 37.0),
    metabolism: (field_multiplier: 1.6, fasting_days: Some(20.0), dehydration_days: 1000.0, intake_per_hour: 0.15),
    movement: (sprint_speed_m_s: Some(6.0), cruise_fraction: 0.2, endurance_s: 1800.0, agility: 1.0, flight_altitude_m: 30.0),
    perception: (vision_m: 100.0, fov_deg: 300.0, hearing_m: 50.0),
    life: (lifespan_years: 40.0, maturity_days: 3650.0),
    reproduction: (
        mode: sexual,
        development: live(gestation_days: 365.0),
        litter: (1, 1),
        breeding_seasons: [],
        interval_days: 730.0,
        parental_care_days: 0.0,
        birth_mass_fraction: Some(0.03),
        min_energy_fraction: 0.5,
    ),
    social: (structure: solitary, group_size: (1, 1), cohesion: 0.0, alignment: None, territorial: false, territory_radius_m: 0.0, alarm_calls: false),
    behaviour: (
        activity: cathemeral,
        weights: (forage: 1.0, hunt: 0.0, scavenge: 0.0, flee: 2.0, drink: 0.0, rest: 0.3, sleep: 1.0, mate: 1.0, wander: 0.3, defend: 0.0, migrate: 0.0),
        boldness: 0.6,
        vigilance: 0.4,
        hunting: none,
    ),
    combat: (attack: 0.1, defence: 1.5, aggression: 0.0),
    climate: (preferred_c: (20.0, 30.0), tolerance_c: (12.0, 34.0)),
    seasonal: (migrates: false, migration_range_m: 2000.0, hibernation: None),
    representation: individual,
    visual: (model: Some("manta_ray"), procedural: Some("manta_ray"), body_plan: fish, color: (0.2, 0.22, 0.28), scale: 1.0),
)
