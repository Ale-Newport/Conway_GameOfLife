// Northern pike (Esox lucius): solitary ambush predator of vegetated lakes, apex of the lake.
// Mass ≈ 1–5 kg, longevity 30 yr record, maturity 2.4–3.1 yr, burst swimming: docs/research/
// ecology-alife.md §10.3 (Hirt et al. 2017 gives 5–7.6 km/h cruising).
// Fish feel the air temperature of their cell (at least 4 °C in water) as a proxy for water
// temperature. `litter` counts recruits that survive the larval stage, not eggs.
// Procedural `pike` rig.
(
    id: "pike",
    name: "Northern pike",
    scientific_name: "Esox lucius",
    class: fish,
    roles: [carnivore, predator, apex, solitary],
    diet: [
        (food: prey("perch"), preference: 1.0),
        (food: prey("small_fish"), preference: 0.8),
        (food: prey("bream"), preference: 0.6),
        (food: prey("frog"), preference: 0.5),
        (food: prey("duck"), preference: 0.3),
    ],
    locomotion: [swim],
    habitat: (
        biomes: [lake, river, wetland],
        aquatic: true,
        water: fresh,
        min_depth_m: 0.5,
        max_slope: 100.0,
        max_wade_depth_m: 0.0,
        refuges: [],
    ),
    body: (mass_kg: 3.0, length_m: 0.7, thermoregulation: ectotherm, body_temperature_c: 37.0),
    metabolism: (field_multiplier: 1.8, fasting_days: Some(20.0), dehydration_days: 1000.0, intake_per_hour: 2.0),
    movement: (sprint_speed_m_s: Some(3.0), cruise_fraction: 0.2, endurance_s: 60.0, agility: 4.0, flight_altitude_m: 30.0),
    perception: (vision_m: 15.0, fov_deg: 300.0, hearing_m: 8.0),
    life: (lifespan_years: 15.0, maturity_days: 900.0),
    reproduction: (
        mode: sexual,
        development: eggs(laying_days: 3.0, incubation_days: 14.0),
        litter: (2, 6),
        breeding_seasons: [spring],
        interval_days: 330.0,
        parental_care_days: 0.0,
        birth_mass_fraction: Some(0.005),
        min_energy_fraction: 0.5,
    ),
    social: (structure: solitary, group_size: (1, 1), cohesion: 0.0, alignment: None, territorial: true, territory_radius_m: 60.0, alarm_calls: false),
    behaviour: (
        activity: crepuscular,
        weights: (forage: 0.6, hunt: 1.3, scavenge: 0.0, flee: 1.0, drink: 0.0, rest: 0.7, sleep: 1.0, mate: 1.0, wander: 0.1, defend: 0.5, migrate: 0.0),
        boldness: 0.8,
        vigilance: 0.4,
        hunting: ambush,
    ),
    combat: (attack: 0.8, defence: 0.4, aggression: 0.6),
    climate: (preferred_c: (8.0, 24.0), tolerance_c: (-30.0, 30.0)),
    seasonal: (migrates: false, migration_range_m: 2000.0, hibernation: None),
    representation: individual,
    visual: (model: None, procedural: Some("pike"), body_plan: fish, color: (0.35, 0.45, 0.25), scale: 1.0),
)
