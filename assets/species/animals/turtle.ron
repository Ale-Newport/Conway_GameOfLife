    id: "turtle",
    name: "European pond turtle",
    scientific_name: "Emys orbicularis",
    class: reptile,
    roles: [omnivore, predator, scavenger, prey, solitary],
    diet: [
        (food: plant(aquatic), preference: 0.8),
        (food: carrion, preference: 0.5),
