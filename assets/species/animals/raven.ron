// Common raven (Corvus corax): flying omnivorous scavenger.
// Mass 1.04 kg, longevity 69 yr (captive record; ~15 yr used), maturity 3 yr, clutch 4–6,
// incubation 19 d: docs/research/ecology-alife.md §10.3. Flight speed from Hirt et al. (2017).
// No authored model exists (coverage matrix, docs/research/assets-3d.md §5): procedural `crow` rig.
(
    id: "raven",
    name: "Common raven",
    scientific_name: "Corvus corax",
    class: bird,
    roles: [omnivore, scavenger, social],
    diet: [
        (food: carrion, preference: 1.0),
        (food: plant(shrubs), preference: 0.3),
        (food: detritus, preference: 0.2),
        (food: fungi, preference: 0.1),
        (food: prey("beetle"), preference: 0.3),
        (food: eggs, preference: 0.6),
    ],
    locomotion: [walk, fly],
    habitat: (
        biomes: [grassland, temperate_forest, tundra, mountain, desert, beach, wetland, savanna],
        max_slope: 100.0,
        max_wade_depth_m: 0.05,
        refuges: [trees],
    ),
    body: (mass_kg: 1.2, length_m: 0.6, thermoregulation: endotherm, body_temperature_c: 40.0),
    metabolism: (field_multiplier: 2.5, fasting_days: Some(3.0), dehydration_days: 2.0, intake_per_hour: 0.8),
    movement: (cruise_fraction: 0.3, endurance_s: 3600.0, agility: 2.0),
    perception: (vision_m: 800.0, fov_deg: 300.0, hearing_m: 200.0),
    life: (lifespan_years: 15.0, maturity_days: 1095.0),
    reproduction: (
        mode: sexual,
        development: eggs(laying_days: 5.0, incubation_days: 19.0),
        litter: (4, 6),
        breeding_seasons: [spring],
        interval_days: 330.0,
        parental_care_days: 40.0,
        birth_mass_fraction: Some(0.02),
        min_energy_fraction: 0.5,
    ),
    social: (structure: pair, group_size: (1, 2), cohesion: 0.3, territorial: true, territory_radius_m: 1500.0),
    behaviour: (
        activity: diurnal,
        weights: (forage: 0.6, hunt: 0.0, scavenge: 1.4, flee: 2.0, drink: 1.0, rest: 0.5, sleep: 1.0, mate: 1.0, wander: 0.3),
        boldness: 0.6,
        vigilance: 0.7,
        hunting: none,
    ),
    combat: (attack: 0.2, defence: 0.3, aggression: 0.3),
    climate: (preferred_c: (-10.0, 25.0), tolerance_c: (-45.0, 45.0)),
    visual: (model: None, procedural: Some("crow"), body_plan: bird, color: (0.05, 0.05, 0.07), scale: 1.0),
)
