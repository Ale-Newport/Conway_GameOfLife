// Vegetation layers (per-cell biomass fields). Designer values calibrated to standing biomass
// and productivity orders of magnitude in docs/research/ecology-alife.md §4 (logistic growth,
// Beer–Lambert light, Liebig limitation, beta temperature response, Eppley algae).
// capacity_kg_m2 is the carrying capacity K per biome (kg dry matter / m²). Germination and
// seedling biomass define the additive recruitment (seeds and surviving roots) of sparse layers.
[
    (
        layer: grass,
        name: "Grasses",
        height_m: 0.4,
        growth_per_day: 0.12,
        capacity_kg_m2: [
            (grassland, 0.5), (savanna, 0.6), (temperate_forest, 0.25), (wetland, 0.4), (tundra, 0.15),
            (mountain, 0.15), (beach, 0.1), (tropical_rainforest, 0.1), (desert, 0.02),
        ],
        light_saturation: 0.5,
        temperature_c: (2.0, 22.0, 40.0),
        moisture: (0.12, 0.45),
        nutrient_g_per_kg: 20.0,
        half_saturation_g_m2: 2.0,
        turnover_per_day: 0.01,
        cold_dieback_per_day: 0.02,
        drought_dieback_per_day: 0.03,
        flood_dieback_per_day: 0.05,
        leaf_area_per_kg: 8.0,
        flammability: 1.0,
        germination_per_day: 0.3,
        seedling_kg_m2: 0.01,
        dispersal_per_day: 0.05,
        mycorrhizal: true,
        residual_kg_m2: 0.02,
        models: ["grass", "grass_wispy_a", "grass_wispy_b", "grass_tall", "kenney_grass", "kenney_grass_large"],
    ),
    (
        layer: shrubs,
        name: "Shrubs and berry bushes",
        height_m: 1.5,
        growth_per_day: 0.02,
        capacity_kg_m2: [
            (temperate_forest, 0.8), (grassland, 0.3), (savanna, 0.5), (wetland, 0.4), (tundra, 0.3),
            (mountain, 0.3), (beach, 0.2), (tropical_rainforest, 0.6), (desert, 0.05),
        ],
        light_saturation: 0.35,
        temperature_c: (0.0, 20.0, 38.0),
        moisture: (0.15, 0.5),
        nutrient_g_per_kg: 15.0,
        half_saturation_g_m2: 2.0,
        turnover_per_day: 0.004,
        cold_dieback_per_day: 0.002,
        drought_dieback_per_day: 0.01,
        flood_dieback_per_day: 0.02,
        leaf_area_per_kg: 4.0,
        flammability: 0.7,
        germination_per_day: 0.01,
        seedling_kg_m2: 0.003,
        dispersal_per_day: 0.01,
        mycorrhizal: true,
        residual_kg_m2: 0.05,
        models: ["bush", "bush_flowering", "kenney_plant_bush"],
    ),
    (
        layer: flowers,
        name: "Flowering herbs",
        height_m: 0.3,
        growth_per_day: 0.1,
        capacity_kg_m2: [
            (grassland, 0.08), (temperate_forest, 0.05), (savanna, 0.06), (wetland, 0.06), (mountain, 0.05),
            (tundra, 0.03), (beach, 0.03), (tropical_rainforest, 0.04), (desert, 0.02),
        ],
        light_saturation: 0.6,
        temperature_c: (5.0, 20.0, 35.0),
        moisture: (0.15, 0.45),
        nutrient_g_per_kg: 25.0,
        half_saturation_g_m2: 2.0,
        turnover_per_day: 0.02,
        cold_dieback_per_day: 0.05,
        drought_dieback_per_day: 0.04,
        flood_dieback_per_day: 0.05,
        leaf_area_per_kg: 12.0,
        flammability: 0.6,
        germination_per_day: 0.04,
        seedling_kg_m2: 0.002,
        dispersal_per_day: 0.03,
        // Insect-pollinated: a fully pollinated meadow adds 2 % of a full seed bank per day
