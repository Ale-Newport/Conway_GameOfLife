// Kapok (Ceiba pentandra): fast-growing emergent tree of tropical rainforests and wet savannas,
// up to 60 m, wind-dispersed seeds in floss. Designer values, order of magnitude (research note
// §10.5 "tropical" plant functional type). No authored kapok model: broadleaf models stand in.
(
    id: "ceiba",
    name: "Kapok",
    scientific_name: "Ceiba pentandra",
    style: broadleaf,
    deciduous: false,
    max_height_m: 45.0,
    mature_biomass_kg: 6000.0,
    crown_ratio: 0.35,
    leaf_area_index: 6.0,
    leaf_area_per_kg: 14.0,
    height_growth_m_per_year: 1.5,
    maturity_years: 15.0,
    lifespan_years: 300.0,
    shade_tolerance: 0.3,
    drought_tolerance: 0.4,
    temperature_c: (12.0, 28.0, 42.0),
    biomes: [tropical_rainforest, savanna],
    seeds_per_year: 40.0,
    seeding_seasons: [],
    dispersal: two_dt(scale_m2: 900.0, shape: 1.5),
    wood_nutrient_g_per_kg: 1.5,
    leaf_nutrient_g_per_kg: 22.0,
    bark_resistance: 0.3,
    flammability: 0.2,
    resprouts: false,
    models: (
        young: ["tree_broadleaf_a", "kenney_tree_default"],
        mature: ["tree_broadleaf_d", "tree_broadleaf_e", "kenney_tree_default"],
        old: ["tree_twisted_e"],
        dead: ["tree_dead_d"],
    ),
)
