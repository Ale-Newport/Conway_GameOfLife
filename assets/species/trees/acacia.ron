// Umbrella-thorn acacia (Vachellia tortilis): flat-crowned savanna tree, very drought tolerant,
// resprouts after grass fires. Designer values; no authored acacia model exists, so the twisted
// broadleaf models stand in (docs/research/assets-3d.md §5).
(
    id: "acacia",
    name: "Umbrella thorn acacia",
    scientific_name: "Vachellia tortilis",
    style: acacia,
    deciduous: false,
    max_height_m: 12.0,
    mature_biomass_kg: 500.0,
    crown_ratio: 0.5,
    leaf_area_index: 2.0,
    leaf_area_per_kg: 10.0,
    height_growth_m_per_year: 0.4,
    maturity_years: 6.0,
    lifespan_years: 120.0,
    shade_tolerance: 0.1,
    drought_tolerance: 0.9,
    temperature_c: (12.0, 28.0, 46.0),
    biomes: [savanna, desert, grassland],
    seeds_per_year: 20.0,
    seeding_seasons: [summer],
    dispersal: exponential(mean_m: 20.0),
    wood_nutrient_g_per_kg: 2.0,
    leaf_nutrient_g_per_kg: 25.0,
    bark_resistance: 0.5,
    flammability: 0.3,
    resprouts: true,
    models: (
        young: ["tree_twisted_d"],
        mature: ["tree_twisted_a", "tree_twisted_b", "tree_twisted_e"],
        old: ["tree_twisted_c"],
        dead: ["tree_dead_e"],
    ),
)
