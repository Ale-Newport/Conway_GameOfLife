// Pedunculate oak (Quercus robur): slow, late-successional broadleaf with thick bark.
// Height 25–40 m, acorns from ~40 yr, lifespan 500–1000+ yr (research note §10.5; designer
// values, order of magnitude). Heavy acorns: short gravity dispersal (animal caching is part 2).
(
    id: "oak",
    name: "Pedunculate oak",
    scientific_name: "Quercus robur",
    style: broadleaf,
    deciduous: true,
    max_height_m: 30.0,
    mature_biomass_kg: 3000.0,
    crown_ratio: 0.3,
    leaf_area_index: 5.0,
    leaf_area_per_kg: 15.0,
    height_growth_m_per_year: 0.35,
    maturity_years: 40.0,
    lifespan_years: 500.0,
    shade_tolerance: 0.5,
    drought_tolerance: 0.5,
    temperature_c: (2.0, 20.0, 38.0),
    biomes: [temperate_forest, grassland],
    seeds_per_year: 20.0,
    seeding_seasons: [autumn],
    dispersal: exponential(mean_m: 20.0),
    wood_nutrient_g_per_kg: 1.5,
    leaf_nutrient_g_per_kg: 20.0,
    bark_resistance: 0.7,
    flammability: 0.25,
    resprouts: true,
    models: (
        young: ["tree_broadleaf_a", "tree_broadleaf_b"],
        mature: ["tree_broadleaf_c", "tree_broadleaf_d", "tree_broadleaf_e", "kenney_tree_oak"],
        old: ["tree_twisted_a", "tree_twisted_b", "tree_twisted_c"],
        dead: ["tree_dead_a", "tree_dead_b", "tree_dead_c"],
    ),
)
