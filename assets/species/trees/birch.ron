// Silver birch (Betula pendula): fast, light-demanding pioneer that recolonises burns.
// Height 20–30 m, seeds from ~5–15 yr, lifespan 80–100 yr, tiny wind-dispersed seeds with a
// long tail (2Dt kernel), killed by fire (research note §10.5; designer values).
(
    id: "birch",
    name: "Silver birch",
    scientific_name: "Betula pendula",
    style: broadleaf,
    deciduous: true,
    max_height_m: 25.0,
    mature_biomass_kg: 800.0,
    crown_ratio: 0.22,
    leaf_area_index: 3.5,
    leaf_area_per_kg: 16.0,
    height_growth_m_per_year: 0.7,
    maturity_years: 10.0,
    lifespan_years: 90.0,
    shade_tolerance: 0.1,
    drought_tolerance: 0.4,
    temperature_c: (0.0, 17.0, 34.0),
    biomes: [temperate_forest, grassland, tundra, wetland],
    seeds_per_year: 40.0,
    seeding_seasons: [summer, autumn],
    dispersal: two_dt(scale_m2: 900.0, shape: 1.0),
    wood_nutrient_g_per_kg: 1.2,
    leaf_nutrient_g_per_kg: 22.0,
    bark_resistance: 0.2,
    flammability: 0.35,
    resprouts: false,
    models: (
        young: ["tree_broadleaf_a", "tree_broadleaf_b"],
        mature: ["tree_broadleaf_c", "tree_broadleaf_d", "tree_broadleaf_e"],
        old: ["tree_broadleaf_e"],
        dead: ["tree_dead_d", "tree_dead_e"],
    ),
)
